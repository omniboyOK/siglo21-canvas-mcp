{
  "name": "s21-canvas-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP para interactuar con Canvas LMS de Universidad Siglo 21 y extraer contenido de lecturas/PDFs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "s21-canvas-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc && node scripts/postbuild.js",
    "start": "node dist/index.js",
    "server": "npm run build && node scripts/dev.js --no-open",
    "dev": "npm run build && node scripts/dev.js mcp",
    "portal": "npm run build && node scripts/dev.js home",
    "test": "npm run build && node scripts/run-tests.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "siglo21",
    "canvas-lms",
    "education",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.8.2"
  }
}
